/* ===== Colors Page — Bouncy Toy Box ===== */
.colors-page {
  padding-bottom: 80rpx;
}

/* Prompt Card — 更大，更醒目 */
.prompt-card {
  margin-top: 24rpx;
  padding: 36rpx 32rpx;
  text-align: center;
}

.prompt-badge {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 107, 0.15);
  color: #ff6b6b;
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 20rpx;
}

.prompt-question {
  font-size: 44rpx;
  font-weight: 900;
  color: #2d3436;
  line-height: 1.4;
}

.prompt-target {
  color: #ff6b6b;
  font-size: 52rpx;
}

.prompt-emoji-wrap {
  margin: 24rpx auto;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff9e6, #ffeaa7);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffd93d;
  box-shadow: 0 6rpx 20rpx rgba(255, 217, 61, 0.3);
  animation: bounceUpDown 2s ease-in-out infinite;
}

.prompt-emoji {
  font-size: 88rpx;
  line-height: 1;
}

/* Color Grid — 更大色卡 */
.color-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.color-card {
  min-height: 220rpx;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.12),
              0 12rpx 32rpx rgba(0,0,0,0.08);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.color-card:active {
  transform: scale(0.9);
}

.color-emoji {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 12rpx;
}

.color-label {
  font-size: 32rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.color-shine {
  position: absolute;
  top: -50%;
  left: -30%;
  width: 60%;
  height: 200%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  transform: rotate(25deg);
  pointer-events: none;
}

/* ===== Daily Page ===== */
.daily-page {
  padding-bottom: 80rpx;
}

.task-card {
  margin-top: 24rpx;
  padding: 32rpx;
  text-align: center;
}

.task-badge {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4d96ff, #68d6ff);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  margin-bottom: 20rpx;
}

.task-prompt {
  font-size: 40rpx;
  font-weight: 900;
  color: #2d3436;
  line-height: 1.4;
}

.task-hint {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(253, 203, 110, 0.2);
  color: #e17055;
  font-size: 28rpx;
  font-weight: 700;
}

/* Choice Grid — 更大选项卡 */
.choice-grid {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.choice-card {
  min-height: 200rpx;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.5);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1),
              0 12rpx 32rpx rgba(0,0,0,0.06);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.choice-card:active {
  transform: scale(0.9);
}

.choice-emoji {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.choice-label {
  font-size: 30rpx;
  font-weight: 900;
  color: #2d3436;
}

/* Listen Section */
.listen-section {
  margin-top: 24rpx;
}

.listen-replay-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4d96ff, #68d6ff);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(77, 150, 255, 0.3);
  border: 0;
}

.listen-replay-btn:active {
  transform: scale(0.95);
}

.listen-replay-icon {
  font-size: 36rpx;
}

/* Color Match */
.color-match-section {
  margin-top: 24rpx;
}

.color-match-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.color-match-card {
  min-height: 200rpx;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.1);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.color-match-card:active {
  transform: scale(0.9);
}

.color-match-emoji {
  font-size: 72rpx;
  margin-bottom: 8rpx;
}

.color-match-label {
  font-size: 30rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

/* Find It */
.find-it-section {
  margin-top: 24rpx;
}

.find-it-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.find-it-card {
  aspect-ratio: 1;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(80, 102, 135, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 93, 0.06);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.find-it-card:active {
  transform: scale(0.9);
}

.find-it-emoji {
  font-size: 64rpx;
}

/* Word Bubble */
.bubble-section {
  margin-top: 24rpx;
}

.bubble-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.bubble-card {
  min-height: 120rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.3);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bubble-card:active {
  transform: scale(0.9);
}

/* Hint Toggle */
.hint-toggle {
  margin-top: 24rpx;
  text-align: center;
}

.hint-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 80rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: rgba(253, 203, 110, 0.2);
  border: 2rpx solid rgba(253, 203, 110, 0.4);
  color: #e17055;
  font-size: 30rpx;
  font-weight: 900;
}

.hint-btn:active {
  transform: scale(0.95);
}

/* Guide Row */
.guide-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.guide-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #636e72;
}
