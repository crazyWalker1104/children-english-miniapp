<view class="page colors-page page-{{layoutMode}}">
  <topbar title="颜色乐园" bind:back="back" />

  <!-- Prompt Card -->
  <view class="prompt-card card">
    <view class="prompt-badge">听一听，点一点</view>
    <view class="prompt-question">找找 <text class="prompt-target">{{target.label}}</text>！</view>
    <view class="prompt-emoji-wrap">
      <text class="prompt-emoji">{{target.emoji}}</text>
    </view>
    <progress-dots dots="{{progressDots}}" />
  </view>

  <!-- Color Grid -->
  <view class="color-grid">
    <button
      wx:for="{{colors}}"
      wx:key="id"
      class="color-card"
      style="background: {{item.color}};"
      data-id="{{item.id}}"
      bind:tap="tapColor"
    >
      <view class="color-emoji">{{item.emoji}}</view>
      <view class="color-label">{{item.label}}</view>
      <view class="color-shine"></view>
    </button>
  </view>

  <!-- Feedback -->
  <feedback-toast text="{{feedback}}" type="{{roundDone ? 'success' : 'default'}}" />

  <!-- Next Button -->
  <button wx:if="{{roundDone}}" class="next-card {{sessionComplete ? 'finished' : ''}}" bind:tap="nextPrompt">
    {{sessionComplete ? '🎉 再玩一组颜色' : '下一个颜色 →'}}
  </button>
</view>