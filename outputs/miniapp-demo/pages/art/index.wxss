/* ===== Art Page — Bouncy Toy Box ===== */
.art-page {
  padding-bottom: 80rpx;
}

/* Art Prompt Card */
.art-prompt {
  margin-top: 24rpx;
  padding: 32rpx;
}

.prompt-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #2d3436;
  text-align: center;
  margin-bottom: 24rpx;
}

.prompt-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.prompt-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #636e72;
}

.prompt-step .step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fdcb6e, #e17055);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Puzzle Board — 更大，更有玩具感 */
.puzzle-board {
  margin-top: 28rpx;
  position: relative;
  border-radius: 36rpx;
  overflow: hidden;
  min-height: 400rpx;
  background: #f5f6fa;
  box-shadow: 0 6rpx 20rpx rgba(44, 62, 93, 0.1),
              0 14rpx 36rpx rgba(44, 62, 93, 0.06);
}

.board-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.board-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(0,0,0,0.25));
}

.board-star {
  position: absolute;
  color: rgba(255,255,255,0.6);
  font-size: 32rpx;
  animation: floatUpDown 3s ease-in-out infinite;
  pointer-events: none;
  z-index: 1;
}

.star-1 { top: 20rpx; left: 30rpx; animation-delay: 0s; }
.star-2 { top: 40rpx; right: 40rpx; animation-delay: 0.5s; font-size: 24rpx; }
.star-3 { bottom: 40rpx; left: 50rpx; animation-delay: 1s; }
.star-4 { bottom: 30rpx; right: 30rpx; animation-delay: 1.5s; font-size: 28rpx; }

/* Board Grid */
.board-grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 8rpx;
  padding: 20rpx;
  height: 100%;
}

.board-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
.board-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }

.board-slot {
  aspect-ratio: 1;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.15);
  border: 3rpx dashed rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 0;
  transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
}

.board-slot.filled {
  background: rgba(255,255,255,0.1);
  border: 3rpx solid rgba(255,255,255,0.6);
  animation: popBounce 0.4s ease;
}

.board-slot.ready {
  background: rgba(255,255,255,0.26);
  border-color: rgba(253, 203, 110, 0.86);
  box-shadow: inset 0 0 0 4rpx rgba(253, 203, 110, 0.22);
}

.board-slot:active {
  transform: scale(0.95);
}

.slot-picture,
.slot-empty {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slot-picture {
  background-repeat: no-repeat;
  background-color: rgba(255,255,255,0.2);
}

.slot-empty {
  background: rgba(255,255,255,0.08);
}

.slot-number {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(45, 52, 54, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.slot-placeholder {
  font-size: 36rpx;
  font-weight: 900;
  color: rgba(255,255,255,0.5);
}

/* Progress Bar — 更大 */
.puzzle-progress {
  margin-top: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 24rpx;
  border-radius: 999rpx;
  background: #f5f6fa;
  overflow: hidden;
  box-shadow: inset 0 2rpx 6rpx rgba(0,0,0,0.06);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6bcb77, #4fd1c5);
  transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: progressGlow 2s ease-in-out infinite;
}

.progress-text {
  margin-top: 12rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #2d6a4f;
}

/* Piece Grid — 更大拼图块 */
.piece-grid {
  margin-top: 24rpx;
  display: grid;
  gap: 16rpx;
}

.piece-grid.cols-2 { grid-template-columns: repeat(2, 1fr); }
.piece-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }

.piece-card {
  aspect-ratio: 1;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff, #f5f6fa);
  border: 4rpx solid rgba(80, 102, 135, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 93, 0.06);
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
  padding: 10rpx;
}

.piece-card:active {
  transform: scale(0.88);
}

.piece-card.selected {
  border-color: #e17055;
  box-shadow: 0 6rpx 20rpx rgba(253, 203, 110, 0.4);
  transform: scale(1.08);
  animation: megaPulse 1.5s ease-in-out infinite;
}

.piece-card.placed {
  opacity: 0.3;
  pointer-events: none;
}

.piece-picture {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
  background-repeat: no-repeat;
  box-shadow: inset 0 0 0 4rpx rgba(255,255,255,0.48);
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  overflow: hidden;
}

.piece-num {
  width: 58rpx;
  height: 58rpx;
  margin: 10rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
  color: #2d3436;
}

.piece-card.selected .piece-num {
  background: #fdcb6e;
  color: #ffffff;
}

.piece-done {
  font-size: 48rpx;
  color: #6bcb77;
}

/* Auto Hint */
.auto-hint {
  margin-top: 20rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(253, 203, 110, 0.2);
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #e17055;
  animation: fadeInUp 0.3s ease;
}

/* Completion Banner — 更大庆祝 */
.completion-banner {
  margin-top: 28rpx;
  padding: 40rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #6bcb77, #4fd1c5);
  text-align: center;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(107, 203, 119, 0.35);
  animation: bounceIn 0.6s ease;
}

.completion-icon {
  font-size: 88rpx;
  line-height: 1;
}

.completion-text {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 900;
}

.completion-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  opacity: 0.9;
}
