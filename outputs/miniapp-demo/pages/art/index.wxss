.painting {
  margin-top: 28rpx;
  min-height: 420rpx;
  padding: 28rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, #183b8f, #4dabf7 58%, #101a56);
}

.painting::after {
  content: "";
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: -34rpx;
  height: 104rpx;
  background: #16255f;
  border-radius: 50% 50% 0 0;
}

.board-grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 12rpx;
  height: 364rpx;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
}

.board-slot {
  min-height: 104rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.52);
  border-radius: 20rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 34rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.12);
}

.board-slot.filled {
  border-style: solid;
  color: #5f4300;
  background: #ffe066;
}

.star {
  position: absolute;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ffd43b;
}

.star-a {
  left: 96rpx;
  top: 56rpx;
}

.star-b {
  right: 132rpx;
  top: 48rpx;
}

.star-c {
  right: 72rpx;
  top: 118rpx;
}

.puzzle-status {
  margin-top: 20rpx;
  color: #6c7890;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.puzzle-grid {
  margin-top: 28rpx;
  display: grid;
  gap: 20rpx;
}

.piece {
  min-height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 900;
}

.piece.done {
  background: #fff7cc;
  color: #f6b321;
}

.piece.selected {
  border-color: rgba(255, 143, 122, 0.92);
  box-shadow: 0 14rpx 28rpx rgba(255, 143, 122, 0.18);
  transform: translateY(-4rpx);
}

.art-prompt {
  margin-top: 28rpx;
  padding: 26rpx;
  text-align: center;
}

.prompt {
  font-size: 40rpx;
  font-weight: 900;
}
