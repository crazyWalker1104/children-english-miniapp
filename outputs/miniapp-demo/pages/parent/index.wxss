.profile {
  margin-top: 28rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-title {
  font-size: 32rpx;
  font-weight: 900;
}

.age-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-color: rgba(114, 214, 183, 0.18);
}

.age-options {
  margin: 20rpx 0 14rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.age-option {
  height: 78rpx;
  border-radius: 999rpx;
  background: #f7fafc;
  color: #6c7890;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.age-option.active {
  color: #087f5b;
  background: rgba(114, 214, 183, 0.22);
  border: 2rpx solid rgba(114, 214, 183, 0.65);
}

.stats {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.stat {
  min-height: 104rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stat text {
  color: #6c7890;
  font-size: 26rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 900;
  color: #243047;
}

.tip {
  margin-top: 28rpx;
  padding: 28rpx;
}

.detail-panel {
  margin-top: 24rpx;
  padding: 28rpx;
}

.tag-list {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.word-tag,
.reward-tag {
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 900;
}

.word-tag {
  color: #245b82;
  background: rgba(124, 199, 246, 0.2);
}

.reward-tag {
  color: #9b6500;
  background: rgba(255, 211, 66, 0.24);
}

.empty-text {
  color: #6c7890;
  font-size: 24rpx;
}
