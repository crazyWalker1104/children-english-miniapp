/* ===== Daily Page ===== */
.daily-page {
  padding-bottom: 80rpx;
}

/* Task Card */
.task-card {
  margin-top: 28rpx;
  padding: 34rpx;
  text-align: center;
  border-color: rgba(255, 107, 107, 0.15);
  background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(255,248,245,0.96) 100%);
}

.task-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 107, 107, 0.1);
  color: #ff6b6b;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.task-prompt {
  font-size: 52rpx;
  font-weight: 900;
  color: #2d3436;
  line-height: 1.3;
}

/* Choice Grid */
.choice-grid {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.choice-card {
  min-height: 190rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.choice-card:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.choice-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.choice-label {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.55);
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.5);
}

/* Guide Row */
.task-hint {
  margin-top: 16rpx;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 217, 61, 0.2);
  color: #b8860b;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  animation: fadeInUp 0.3s ease;
}

.guide-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.guide-text {
  color: #636e72;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(253, 203, 110, 0.25);
  max-width: 60%;
  text-align: center;
  line-height: 1.5;
}

/* ===== 听音选图 ===== */
.listen-section {
  margin-top: 30rpx;
}

.listen-replay-btn {
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(77, 150, 255, 0.15);
  color: #4d96ff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 auto 20rpx;
}

.listen-replay-icon {
  font-size: 28rpx;
}

/* ===== 颜色配对 ===== */
.color-match-section {
  margin-top: 30rpx;
}

.color-match-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.color-match-card {
  min-height: 160rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.06);
  transition: transform 0.15s ease;
}

.color-match-card:active {
  transform: scale(0.95);
}

.color-match-emoji {
  font-size: 48rpx;
  line-height: 1;
}

.color-match-label {
  margin-top: 10rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.55);
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.5);
}

/* ===== 找一找 ===== */
.find-it-section {
  margin-top: 30rpx;
}

.find-it-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.find-it-card {
  min-height: 140rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.94);
  border: 2rpx solid rgba(80, 102, 135, 0.06);
  box-shadow: 0 2rpx 8rpx rgba(44, 62, 93, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.find-it-card:active {
  transform: scale(0.95);
  background: rgba(255, 217, 61, 0.15);
}

.find-it-emoji {
  font-size: 52rpx;
  line-height: 1;
}

/* ===== 单词气泡 ===== */
.bubble-section {
  margin-top: 30rpx;
}

.bubble-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24rpx;
}

.bubble-card {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.25);
  border: 0;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  animation: floatUpDown 3s ease-in-out infinite;
}

.bubble-card:nth-child(even) {
  animation-delay: 0.5s;
  background: linear-gradient(135deg, #74b9ff, #4d96ff);
}

.bubble-card:nth-child(3n) {
  animation-delay: 1s;
  background: linear-gradient(135deg, #ff6b6b, #ffa06b);
}

.bubble-card:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(108, 92, 231, 0.2);
}

/* ===== Hint Button ===== */
.hint-toggle {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.hint-btn {
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 217, 61, 0.2);
  color: #b8860b;
  font-size: 24rpx;
  font-weight: 800;
}