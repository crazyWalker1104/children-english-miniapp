/* ===== Songs Page — Bouncy Toy Box ===== */
.songs-page {
  padding-bottom: 80rpx;
}

.song-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* Song Card — 更大，更有专辑封面感 */
.song-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 140rpx;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  background: rgba(255,255,255,0.95);
  border: 3rpx solid rgba(80, 102, 135, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 93, 0.06),
              0 10rpx 28rpx rgba(44, 62, 93, 0.06);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  border: 0;
}

.song-card:active {
  transform: scale(0.96);
}

.song-card.active {
  background: linear-gradient(135deg, #6bcb77, #4fd1c5);
  box-shadow: 0 6rpx 20rpx rgba(107, 203, 119, 0.3),
              0 14rpx 36rpx rgba(107, 203, 119, 0.15);
}

.song-info {
  text-align: left;
  flex: 1;
  min-width: 0;
}

.song-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #2d3436;
}

.song-card.active .song-title {
  color: #ffffff;
}

.song-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #636e72;
  font-weight: 600;
}

.song-card.active .song-meta {
  color: rgba(255,255,255,0.85);
}

/* Play Button — 更大，更醒目 */
.song-play-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f6fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #6bcb77;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.song-card.active .song-play-btn {
  background: rgba(255,255,255,0.3);
  color: #ffffff;
  animation: heartbeat 2s ease-in-out infinite;
}

/* Lyrics Card — 更大歌词 */
.lyrics-card {
  margin-top: 28rpx;
  padding: 36rpx 32rpx;
}

.lyrics-header {
  text-align: center;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx dashed rgba(80, 102, 135, 0.1);
}

.lyrics-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #2d3436;
}

.lyrics-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #636e72;
}

.audio-status-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.audio-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #6bcb77;
  animation: gentlePulse 1.5s ease-in-out infinite;
}

.audio-status-dot.loading-dot {
  background: #fdcb6e;
}

.audio-status-text {
  font-size: 24rpx;
  color: #636e72;
  font-weight: 700;
}

.audio-status-progress {
  font-size: 24rpx;
  color: #6bcb77;
  font-weight: 900;
}

.lyric-lines {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.lyric-line {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #f5f6fa;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.lyric-line.active {
  background: linear-gradient(135deg, rgba(107, 203, 119, 0.2), rgba(79, 209, 197, 0.15));
  border: 2rpx solid rgba(107, 203, 119, 0.36);
  transform: scale(1.04);
  animation: popBounce 0.4s ease;
}

.lyric-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #2d3436;
}

.lyric-line.active .lyric-text {
  color: #2d6a4f;
}

.lyric-action {
  font-size: 26rpx;
  color: #b2bec3;
  font-weight: 700;
  flex-shrink: 0;
}

.lyric-line.active .lyric-action {
  color: #6bcb77;
}
