<view class="page speak-page page-{{layoutMode}}">
  <topbar title="跟我说" right-icon="↻" bind:back="back" bind:righttap="nextWord" />

  <!-- Word Display Card -->
  <view class="word-card card">
    <view class="word-badge">{{wordCategory}}</view>
    <view class="word-display">{{wordText}}</view>
    <view class="word-hint">{{wordHint}}</view>
    <view class="phrase">{{practicePhrase}}</view>
  </view>

  <!-- Step Flow -->
  <view class="step-flow">
    <view class="step-item {{stepCount >= 1 ? 'done' : ''}} {{stepCount === 0 ? 'current' : ''}}">
      <view class="step-circle">
        <text wx:if="{{stepCount >= 1}}" class="step-check">✓</text>
        <text wx:else class="step-num">1</text>
      </view>
      <view class="step-label">Listen</view>
      <view class="step-desc">听发音</view>
    </view>
    <view class="step-line {{stepCount >= 2 ? 'active' : ''}}"></view>
    <view class="step-item {{stepCount >= 2 ? 'done' : ''}} {{stepCount === 1 ? 'current' : ''}}">
      <view class="step-circle">
        <text wx:if="{{stepCount >= 2}}" class="step-check">✓</text>
        <text wx:else class="step-num">2</text>
      </view>
      <view class="step-label">Say</view>
      <view class="step-desc">大声说</view>
    </view>
    <view class="step-line {{stepCount >= 3 ? 'active' : ''}}"></view>
    <view class="step-item {{stepCount >= 3 ? 'done' : ''}} {{stepCount === 2 ? 'current' : ''}}">
      <view class="step-circle">
        <text wx:if="{{stepCount >= 3}}" class="step-check">✓</text>
        <text wx:else class="step-num">3</text>
      </view>
      <view class="step-label">Smile</view>
      <view class="step-desc">完成啦</view>
    </view>
  </view>

  <!-- Action Buttons -->
  <view class="actions">
    <button class="action-btn action-play" bind:tap="playWord">
      <text class="action-icon">▶</text>
      <text class="action-label">听</text>
    </button>
    <button class="action-btn action-record {{stepCount === 0 ? 'disabled' : ''}}" bind:tap="practice">
      <text class="action-icon">🎤</text>
      <text class="action-label">说</text>
    </button>
    <button class="action-btn action-replay" bind:tap="playWord">
      <text class="action-icon">↺</text>
      <text class="action-label">重播</text>
    </button>
  </view>

  <feedback-toast text="{{feedback}}" type="{{stepCount >= 3 ? 'success' : 'default'}}" />
</view>