/* ===== Speak Page — Bouncy Toy Box ===== */
.speak-page {
  padding-bottom: 80rpx;
}

/* Word Display Card — 更大，更突出 */
.word-card {
  margin-top: 24rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(255, 234, 167, 0.3));
  border: 3rpx solid rgba(253, 203, 110, 0.2);
}

.word-badge {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(162, 155, 254, 0.2);
  color: #6c5ce7;
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 24rpx;
}

.word-display {
  font-size: 80rpx;
  font-weight: 900;
  color: #2d3436;
  letter-spacing: 2rpx;
  animation: popBounce 0.5s ease;
}

.word-hint {
  margin-top: 16rpx;
  font-size: 32rpx;
  color: #636e72;
  font-weight: 700;
}

.phrase {
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(77, 150, 255, 0.1);
  color: #4d96ff;
  font-size: 30rpx;
  font-weight: 800;
  display: inline-block;
}

/* Step Flow — 更大步骤圆圈 */
.step-flow {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f5f6fa;
  border: 4rpx solid #dfe6e9;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.step-item.current .step-circle {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  border-color: #6c5ce7;
  box-shadow: 0 6rpx 20rpx rgba(108, 92, 231, 0.35);
  animation: megaPulse 2s ease-in-out infinite;
}

.step-item.done .step-circle {
  background: linear-gradient(135deg, #6bcb77, #4fd1c5);
  border-color: #6bcb77;
  box-shadow: 0 4rpx 12rpx rgba(107, 203, 119, 0.3);
  animation: spinPop 0.5s ease;
}

.step-check {
  font-size: 44rpx;
  color: #ffffff;
  font-weight: 900;
}

.step-num {
  font-size: 40rpx;
  color: #b2bec3;
  font-weight: 900;
}

.step-label {
  font-size: 26rpx;
  font-weight: 900;
  color: #2d3436;
}

.step-desc {
  font-size: 22rpx;
  color: #b2bec3;
}

.step-line {
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #dfe6e9;
  margin: 0 8rpx;
  margin-bottom: 48rpx;
  transition: background 0.4s ease;
}

.step-line.active {
  background: linear-gradient(90deg, #6bcb77, #4fd1c5);
}

/* Action Buttons — 超大按钮 */
.actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.action-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 0;
  color: #ffffff;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.action-btn:active {
  transform: scale(0.88);
}

.action-play {
  background: linear-gradient(135deg, #4d96ff, #68d6ff);
  box-shadow: 0 8rpx 24rpx rgba(77, 150, 255, 0.35);
}

.action-record {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.35);
}

.action-record.disabled {
  opacity: 0.4;
}

.action-replay {
  background: linear-gradient(135deg, #fdcb6e, #e17055);
  box-shadow: 0 8rpx 24rpx rgba(253, 203, 110, 0.35);
}

.action-icon {
  font-size: 56rpx;
  line-height: 1;
}

.action-label {
  font-size: 24rpx;
  font-weight: 900;
}
