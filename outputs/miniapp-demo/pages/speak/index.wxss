.word-card {
  margin-top: 34rpx;
  min-height: 280rpx;
  padding: 34rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.word {
  margin-top: 18rpx;
  font-size: 76rpx;
  font-weight: 900;
  color: #ff8f7a;
}

.word-meta {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.word-category,
.word-hint {
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #6c7890;
  font-size: 24rpx;
  font-weight: 800;
}

.word-category {
  color: #087f5b;
  background: rgba(114, 214, 183, 0.18);
}

.word-hint {
  background: #f5f8fb;
}

.phrase {
  margin-top: 16rpx;
  color: #243047;
  font-size: 32rpx;
  font-weight: 900;
}

.step-row {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.step-pill {
  min-width: 112rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #6c7890;
  font-size: 24rpx;
  font-weight: 800;
  background: #f5f8fb;
}

.step-pill.active {
  color: #243047;
  background: #fff7cc;
}

.step-pill.done {
  color: #087f5b;
  background: rgba(114, 214, 183, 0.22);
}

.actions {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
  gap: 28rpx;
}

.action {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play {
  background: #7cc7f6;
}

.record {
  background: #ff8f7a;
}

.replay {
  background: #72d6b7;
}
