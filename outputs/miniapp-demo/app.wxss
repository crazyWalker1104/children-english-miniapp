@import "./styles/tokens.wxss";

page {
  min-height: 100vh;
  color: #2d3436;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  background: linear-gradient(180deg, #fef9f0 0%, #fff5e8 28%, #fff1dd 56%, #fff8f2 100%);
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  border: 0;
  background: transparent;
  line-height: 1;
}

button::after {
  border: 0;
}

/* ===== Page Container — 更大边距，呼吸感 ===== */
.page {
  min-height: 100vh;
  padding: 36rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
}

/* ===== Top Bar — 更大高度 ===== */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 900;
  color: #2d3436;
  letter-spacing: 1rpx;
}

.subtitle {
  margin-top: 8rpx;
  color: #636e72;
  font-size: 26rpx;
  line-height: 1.5;
}

/* ===== Round Button — 放大到 88rpx，幼儿手指友好 ===== */
.round-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(44, 62, 93, 0.08),
              0 8rpx 24rpx rgba(44, 62, 93, 0.1);
  font-size: 36rpx;
  font-weight: 900;
  color: #2d3436;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
}

.round-btn:active {
  transform: scale(0.85);
  box-shadow: 0 2rpx 6rpx rgba(44, 62, 93, 0.06);
}

.ghost-btn {
  opacity: 0;
  pointer-events: none;
}

/* ===== Card Base — 更大圆角，更厚阴影 ===== */
.card {
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid rgba(80, 102, 135, 0.06);
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 93, 0.06),
              0 12rpx 32rpx rgba(44, 62, 93, 0.08);
  transition: box-shadow 0.25s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.card:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(44, 62, 93, 0.06),
              0 6rpx 16rpx rgba(44, 62, 93, 0.08);
}

/* ===== Primary Card (gradient hero style) ===== */
.primary-card {
  border-radius: 40rpx;
  padding: 36rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 50%, #ffd93d 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 107, 0.28),
              0 16rpx 40rpx rgba(255, 107, 107, 0.18);
  border: 0;
}

.primary-card:active {
  transform: scale(0.96);
  box-shadow: 0 3rpx 12rpx rgba(255, 107, 107, 0.22),
              0 8rpx 20rpx rgba(255, 107, 107, 0.14);
}

/* ===== Section Headers — 更大标题 ===== */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 900;
  color: #2d3436;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title-emoji {
  font-size: 40rpx;
}

/* ===== Feedback Toast — 更大，更醒目 ===== */
.feedback {
  margin-top: 28rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, 0.95);
  color: #2d3436;
  box-shadow: 0 4rpx 16rpx rgba(44, 62, 93, 0.08),
              0 12rpx 32rpx rgba(44, 62, 93, 0.1);
  animation: bounceIn 0.5s ease;
}

.feedback.success {
  color: #2d6a4f;
  background: linear-gradient(135deg, rgba(107, 203, 119, 0.18), rgba(79, 209, 197, 0.15));
  border: 2rpx solid rgba(107, 203, 119, 0.36);
}

.feedback.error {
  color: #c0392b;
  background: rgba(255, 107, 107, 0.15);
  border: 2rpx solid rgba(255, 107, 107, 0.3);
  animation: wiggle 0.5s ease;
}

/* ===== Next / CTA Button — 更大，更有满足感 ===== */
.next-card {
  margin-top: 28rpx;
  min-height: 104rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2d6a4f;
  font-size: 36rpx;
  font-weight: 900;
  background: rgba(107, 203, 119, 0.2);
  border: 2rpx solid rgba(107, 203, 119, 0.4);
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.next-card:active {
  transform: scale(0.94);
  background: rgba(107, 203, 119, 0.32);
}

.next-card.finished {
  color: #ffffff;
  background: linear-gradient(135deg, #6bcb77 0%, #4fd1c5 100%);
  border: 0;
  box-shadow: 0 6rpx 20rpx rgba(107, 203, 119, 0.35);
  animation: megaPulse 2s ease-in-out infinite;
}

/* ===== Progress Dots — 更大圆点 ===== */
.mini-progress {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #dfe6e9;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.dot.active {
  width: 52rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6bcb77, #4fd1c5);
  animation: fadeInScale 0.35s ease;
}

/* ===== Grid Layout ===== */
.grid-2 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.grid-3 {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* ===== Utility ===== */
.muted {
  color: #636e72;
}

.stars {
  color: #ffd93d;
  letter-spacing: 6rpx;
  font-size: 32rpx;
}

.soft-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #2d6a4f;
  background: rgba(107, 203, 119, 0.18);
  border: 2rpx solid rgba(107, 203, 119, 0.36);
  font-size: 24rpx;
  font-weight: 900;
}

/* Staggered entrance animations — 更弹的入场 */
.entrance-1 { animation: bounceIn 0.5s ease both; }
.entrance-2 { animation: bounceIn 0.5s 0.1s ease both; }
.entrance-3 { animation: bounceIn 0.5s 0.2s ease both; }
.entrance-4 { animation: bounceIn 0.5s 0.3s ease both; }
.entrance-5 { animation: bounceIn 0.5s 0.4s ease both; }

/* ===== Responsive: Tablet ≥ 768px ===== */
@media (min-width: 768px) {
  .page {
    padding-left: 48rpx;
    padding-right: 48rpx;
  }

  .page-tablet .module-grid,
  .page-pc .module-grid,
  .page-tablet .choice-grid,
  .page-pc .choice-grid,
  .page-tablet .color-grid,
  .page-pc .color-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ===== Responsive: PC ≥ 1024px ===== */
@media (min-width: 1024px) {
  .page {
    max-width: 960px;
    margin-left: auto;
    margin-right: auto;
  }

  button:hover {
    opacity: 0.92;
  }
}
